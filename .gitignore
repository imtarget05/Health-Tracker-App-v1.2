# macOS specific files (resource forks and metadata)
._*
.DS_Store
.AppleDouble
.LSOverride

# Ignore nested project directory
Health-Tracker-App/

# Python venvs and caches (repo-wide, not just AI/)
**/__pycache__/
*.pyc
*.pyo
AI/.venv/
AI/.venv311/

# Ignore dotenv files
*.env
.env

# Ignore dataset folder (large data that should not be committed)
Dataset/
Dataset/**

# Local secrets
/backend/.env
/backend/*.json
/frontend/.env
# ML model artifacts. Only best.pt is committed because AI/predictor.py
# loads it at startup and nothing downloads it; every other entry below is
# either training output or a duplicate of best.pt.
/AI/models/*
!/AI/models/best.pt
!/AI/models/data.yaml
!/AI/models/model_info.json
!/AI/models/pipeline_config.json
!/AI/models/nutrition_lookup.csv
!/AI/models/nutrition_mapping.json
!/AI/models/nutrition_mapping.pkl

# Build / caches / editor / virtual envs
/frontend/build/
/frontend/.dart_tool/
/frontend/.git-backup/
/AI/__pycache__/
node_modules/
/frontend/ios/Pods/
/*.log

# Explicit backend secrets
/backend/.env
/backend/*.serviceAccount.json
/backend/*-firebase-adminsdk-*.json

# Runtime upload staging area. src/middleware/upload.middleware.js recreates it on
# startup (fs.mkdirSync) and deletes anything older than 24h, so it must never
# be committed. Four orphan uploads were committed here on 2026-09-26.
/backend/src/middleware/tmp/
